<?xml version="1.0" encoding="utf-8"?>
<!--
Два дефа мода Rimatomics (Dubwise.Rimatomics), на которые ссылается HSK.

Это не про Combat Extended. Пак написан с расчётом на весь свой список модов и ссылается
на их дефы безусловно, поэтому без Rimatomics получаем 53 строки в логе: 52 из них —
Radiation в statBases у пешек, брони и лекарств, то есть StatModifier с null-полем, а это
ещё и мина для любого кода, который потом пройдёт по statBases.

Папка подключается только когда самого Rimatomics нет (LoadFolders.xml), так что с ним
дубликатов не возникает — его собственные дефы остаются единственными.

Содержимого здесь нет: стат объявлен и скрыт, игровое состояние пустое. Если Rimatomics
заработает на 1.7, его стоит просто включить — он даст и дефы, и механику.
-->
<Defs>

	<!-- Устойчивость к радиации: в statBases у множества дефов пака -->
	<StatDef>
		<defName>Radiation</defName>
		<label>radiation sensitivity</label>
		<description>Multiplier on the impact of radiation buildup. Rimatomics only; nothing reads it here.</description>
		<category>BasicsPawn</category>
		<defaultBaseValue>1.0</defaultBaseValue>
		<minValue>0</minValue>
		<hideAtValue>1.0</hideAtValue>
		<toStringStyle>PercentZero</toStringStyle>
		<alwaysHide>true</alwaysHide>
	</StatDef>

	<!--
	Выпадение радиоактивных осадков. Класс условия у Rimatomics свой
	(Rimatomics.GameCondition_NuclearFallout), поэтому берём ванильный: состояние
	существует, объявляется и ничего не делает.
	-->
	<GameConditionDef>
		<defName>NuclearFallout</defName>
		<conditionClass>GameCondition</conditionClass>
		<label>nuclear blast fallout</label>
		<description>A plume of radioactive smoke and ash from a nuclear blast settles over the area.</description>
		<endMessage>The worst of the radioactive dust has been washed away.</endMessage>
		<canBePermanent>true</canBePermanent>
	</GameConditionDef>

	<!--
	Категория ядерных отходов. Пак переносит её под Items отдельным патчем
	(Patches/Mods_Rimatomics/ThingCategories_MovesRimatomics.xml), причём без обёртки
	PatchOperationFindMod — поэтому без Rimatomics операция промахивается. Узел parent
	здесь нужен именно для неё: PatchOperationReplace заменяет его, а не создаёт.
	-->
	<ThingCategoryDef>
		<defName>NuclearWaste</defName>
		<label>nuclear waste</label>
		<parent>Items</parent>
	</ThingCategoryDef>

</Defs>
